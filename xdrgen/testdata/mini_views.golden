}

// sub returns the sub-view starting rel bytes into this view. Callers must
// have bounds-checked rel <= len(v.d).
func (v view) sub(rel int64) view { return view{d: v.d[rel:], off: v.off + rel, w: v.w} }

// trimmed trims the view's data to the given size, propagating a sizing
// error. It is the shared tail of every generated Raw().
func (v view) trimmed(sz int, err error) ([]byte, error) {
