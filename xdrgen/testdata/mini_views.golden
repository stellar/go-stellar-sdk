// maxDepth is the maximum recursion depth for all view operations:
// bundle resolution, Raw(), array iteration, and ValidateFull().
// Matches stellar-core's xdr::marshaling_stack_limit (set in main.cpp).
const maxDepth = 1500

// maxViewOff bounds memoized field offsets: bundle offset memos are int32, so
// any offset that cannot be represented is rejected as malformed (a single XDR
// value larger than 2 GiB is far beyond any schema bound we accept).
const maxViewOff = int64(math.MaxInt32)

// =============================================================================
// The walk — shared traversal state for one parse tree.
// =============================================================================

// walk is the per-parse traversal state shared by every view derived from one
// ParseXView call. It carries the single most recently fully-resolved subtree
// span, which lets generated code resume sizing after bytes the caller already
// consumed instead of re-walking them ("consumption is measurement").
//
// The walk is an optimization channel, NEVER a correctness dependency: views
// with w == nil (detached views, e.g. Copy() results) behave identically minus
// cross-level fusion, and every resumption validates the record before
// trusting it — an inconsistent record falls back to a plain size walk.
//
// The record is identified by (recTid, recStart): recTid is a generator-
// assigned identity of the recorded view TYPE, and recStart the subtree's
// absolute start offset. Both must match exactly for a record to be consumed
// as a node's full extent. The type identity is what makes the record
// unambiguous: a struct and its first field start at the same offset, so a
// bare (start, end) span could not distinguish "this node fully resolved"
// from "a same-start descendant fully resolved". Two distinct nodes of the
// same type at the same offset cannot coexist in one parse tree (any
// recursive re-entry of a type passes through a length/discriminant/presence
// prefix), so (recTid, recStart) identifies a node uniquely.
type walk struct {
	// depth is the base traversal depth for operations launched from this
	// walk's views. Depth limiting is threaded internally through size/valid
	// calls exactly as before; public methods no longer take depth parameters.
	depth    int
	recTid   int32 // type identity of the recorded subtree; tidNone when empty
	recStart int64 // absolute span of the most recently fully-resolved subtree
	recEnd   int64 // recStart == -1 when empty
}

// tidNone is the "no record" type identity. Generated type identities are >= 0.
const tidNone int32 = -1

func newWalk() *walk { return &walk{recTid: tidNone, recStart: -1, recEnd: -1} }

// record notes that the subtree of type identity tid spanning the absolute
// range [start, end) has been fully resolved, overwriting any previous record.
// Records naturally bubble upward: when a parent resolves its own extent by
// consuming its last child's record, it immediately re-records the wider span.
//
// A span that lies entirely BEFORE the current record is dropped instead of
// recorded: it can only come from re-walking already-visited bytes (a leading
// sibling re-sized while a parent resolves its own extent), and letting it
// overwrite would destroy the deeper-right record that same resolution is
// about to consume — e.g. an iterator advance over a struct element whose
// bulk last field was just consumed would re-size the leading fields, clobber
// the bulk field's record with a leading field's span, and then blind-walk
// the bulk field it could have skipped. Keeping the rightmost record is what
// makes "consumed in order ⇒ advance is O(1)" hold for structs with fields
// before the bulk one. Dropping a record is always sound: records are an
// optimization consumed only after hit() validation, never a correctness
// dependency.
func (w *walk) record(tid int32, start, end int64) {
	if w.recStart >= 0 && end <= w.recStart {
		return
	}
	w.recTid, w.recStart, w.recEnd = tid, start, end
}

// hit reports whether the current record is exactly the full extent of the
// node of type identity tid starting at absolute offset start, and returns
// the recorded absolute end. bufEnd is the enclosing buffer's absolute end;
// a record extending past it is inconsistent and is not trusted.
func (w *walk) hit(tid int32, start, bufEnd int64) (int64, bool) {
	if w.recTid == tid && w.recStart == start && w.recEnd >= start && w.recEnd <= bufEnd {
		return w.recEnd, true
	}
	return 0, false
}

