// NewPairsView wraps b (untrusted XDR bytes) in a PairsView — a free
// wrapper, not a parse: nothing is validated up front, no error is possible,
// and every subsequent access bounds-checks and validates what it reads.
// Allocation-free.
func NewPairsView(b []byte) PairsView {
	return PairsView{view{d: b}}
}

// Len returns the element count (O(1), from the count prefix), validated
// against the schema bound and the remaining buffer before use.
func (v PairsView) Len() (uint32, error) {
	n, err := arrayViewCountChecked(v.d, 10, 12)
	return uint32(n), err
}
func sizePairsView(d []byte, depth int) (int, error) {
	if depth > maxDepth {
		return 0, viewErrMaxDepth(0)
	}
	// Cheap unvalidated count: the total-vs-buffer check below bounds work
	// to O(buffer) on a bogus count, so the up-front min-size check is
	// redundant here. The OOM guard (for preallocation) lives in Len()/All().
	count, err := arrayViewCount(d, 10)
	if err != nil {
		return 0, err
	}
	total := int64(4) + int64(count)*int64(12)
	if total > int64(len(d)) {
		return 0, viewErrArrayCountExceedsData(4, count, len(d)-4)
	}
	return int(total), nil
}
func validPairsView(d []byte, depth int) (int, error) {
	if depth > maxDepth {
		return 0, viewErrMaxDepth(0)
	}
	count, err := arrayViewCount(d, 10)
	if err != nil {
		return 0, err
	}
	return arrayTraverse(d, count, 4, func(fd []byte) (int, error) { return validPairView(fd, depth+1) })
}
func (v PairsView) size(depth int) (int, error)  { return sizePairsView(v.d, depth) }
func (v PairsView) valid(depth int) (int, error) { return validPairsView(v.d, depth) }

