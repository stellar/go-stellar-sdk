// =============================================================================
// VarOpaqueView — opaque / string
// Wire layout: [4-byte length][payload][padding to 4-byte boundary]
// =============================================================================

type VarOpaqueView struct{ view }

func ParseVarOpaqueView(b []byte) VarOpaqueView { return VarOpaqueView{view{d: b, w: newWalk()}} }

var zeroPad [3]byte

func (v VarOpaqueView) Value() ([]byte, error) {
	if len(v.d) < 4 {
		return nil, viewErrShortBuffer(0, "need 4 bytes for length")
	}
	length, err := safeUint32ToInt(binary.BigEndian.Uint32(v.d[:4]), 0)
	if err != nil {
		return nil, err
	}
	// Compute total in int64 to avoid overflow on 32-bit platforms where
	// length may reach maxInt32 and (length + 3) would wrap to negative.
	total64 := 4 + ((int64(length) + 3) &^ 3)
	if total64 > int64(len(v.d)) {
		return nil, viewErrShortBuffer(0, fmt.Sprintf("need %d padded bytes", total64))
	}
	total := int(total64)
	padded := total - 4
	if !bytes.Equal(v.d[4+length:total], zeroPad[:padded-length]) {
		return nil, viewErrNonZeroPadding(uint32(4 + length))
	}
	return v.d[4 : 4+length], nil
}

func (v VarOpaqueView) size(_ int) (int, error) {
	if len(v.d) < 4 {
		return 0, viewErrShortBuffer(0, "need 4 bytes for length")
	}
	length, err := safeUint32ToInt(binary.BigEndian.Uint32(v.d[:4]), 0)
	if err != nil {
		return 0, err
	}
	total64 := 4 + ((int64(length) + 3) &^ 3)
	if total64 > int64(len(v.d)) {
		return 0, viewErrShortBuffer(0, fmt.Sprintf("need %d padded bytes, have %d", total64-4, len(v.d)-4))
	}
	return int(total64), nil
}

