		return 4 + sz, nil
	default:
		return 0, viewErrBadBoolValue(0, flag)
	}
}
func (v OptionalMixedView) size(depth int) (int, error) { return sizeOptionalMixedView(v.d, depth) }
func validOptionalMixedView(d []byte, depth int) (int, error) {
	if depth > maxDepth {
		return 0, viewErrMaxDepth(0)
	}
	if len(d) < 4 {
		return 0, viewErrShortBuffer(0, "need 4 bytes for optional flag")
	}
	flag := binary.BigEndian.Uint32(d[:4])
	switch flag {
	case 0:
		return 4, nil
	case 1:
		sz, err := validMixedView(d[4:], depth+1)
		if err != nil {
			return 0, err
		}
		return 4 + sz, nil
	default:
		return 0, viewErrBadBoolValue(0, flag)
	}
}
func (v OptionalMixedView) valid(depth int) (int, error) { return validOptionalMixedView(v.d, depth) }

// Raw returns the exact wire bytes for this view. Views delivered by
// iterators and the Walk are already trimmed to their exact extent, so Raw
// is a slice operation (the exact check precedes any sizing — arguments
// are not evaluated for it); open-ended views (accessor/arm results) are
// sized first.
func (v OptionalMixedView) Raw() ([]byte, error) {
	if v.exact {
		return v.d, nil
	}
	return v.trimmed(v.size(0))
}

// MustRaw is Raw panicking with the *ViewError sentinel (recover via Try*).
func (v OptionalMixedView) MustRaw() []byte {
	raw, err := v.Raw()
	if err != nil {
		mustView(err)
	}
	return raw
}

// Copy returns an independent, detached copy of this view that does not alias the original bytes.
func (v OptionalMixedView) Copy() (OptionalMixedView, error) {
	nv, err := v.copied(v.size(0))
	return OptionalMixedView{nv}, err
}

// ValidateFull checks that this view is well-formed: bounds, schema constraints, and depth limits.
func (v OptionalMixedView) ValidateFull() error { _, err := v.valid(0); return err }

type MixedListView struct{ view }

// NewMixedListView wraps b (untrusted XDR bytes) in a MixedListView — a free
// wrapper, not a parse: nothing is validated up front, no error is possible,
// and every subsequent access bounds-checks and validates what it reads.
// Allocation-free.
func NewMixedListView(b []byte) MixedListView {
	return MixedListView{view{d: b}}
}

// Len returns the element count (O(1), from the count prefix), validated
// against the schema bound and the remaining buffer before use.
func (v MixedListView) Len() (uint32, error) {
	n, err := arrayViewCountChecked(v.d, 8, 40)
	return uint32(n), err
}
func sizeMixedListView(d []byte, depth int) (int, error) {
	if depth > maxDepth {
		return 0, viewErrMaxDepth(0)
	}
	count, err := arrayViewCount(d, 8)
	if err != nil {
		return 0, err
	}
	return arrayTraverse(d, count, 4, func(fd []byte) (int, error) { return sizeMixedView(fd, depth+1) })
}
func validMixedListView(d []byte, depth int) (int, error) {
	if depth > maxDepth {
		return 0, viewErrMaxDepth(0)
	}
	count, err := arrayViewCount(d, 8)
	if err != nil {
		return 0, err
	}
	return arrayTraverse(d, count, 4, func(fd []byte) (int, error) { return validMixedView(fd, depth+1) })
}
func (v MixedListView) size(depth int) (int, error)  { return sizeMixedListView(v.d, depth) }
func (v MixedListView) valid(depth int) (int, error) { return validMixedListView(v.d, depth) }

// MixedListViewScanner iterates MixedListView with the scanner idiom: for
// sc.Next() { sc.Cur() ... }; sc.Err(). Cur views are exact-extent.
type MixedListViewScanner struct {
	d   []byte
	off int64
	n   int
	i   int
	err error
	cur MixedView
}

// Scan returns a scanner over this array's elements.
func (v MixedListView) Scan() MixedListViewScanner {
	sc := MixedListViewScanner{d: v.d}
	n, err := arrayViewCountChecked(v.d, 8, 40)
	if err != nil {
		sc.err = err
		return sc
	}
	sc.n = n
	sc.off = 4
	return sc
}

// Next advances to the next element; false at the end or on error (check Err).
func (sc *MixedListViewScanner) Next() bool {
	if sc.err != nil || sc.i >= sc.n {
		return false
	}
	if sc.off >= int64(len(sc.d)) {
		sc.err = viewErrShortBuffer(uint32(sc.off), "element offset exceeds data")
		return false
	}
	sz, err := sizeMixedView(sc.d[sc.off:], 0)
	if err != nil {
		sc.err = err
		return false
	}
	sc.cur = MixedView{view{d: sc.d[sc.off : sc.off+int64(sz)], exact: true}}
	sc.off += int64(sz)
	sc.i++
	return true
}

// Cur returns the element Next positioned on (exact extent).
func (sc *MixedListViewScanner) Cur() MixedView { return sc.cur }

// Rest returns the UNVALIDATED remainder of the array's window from the
// scanner's current position — a power-tool escape hatch for consumers
// that advance by externally computed extents (e.g. a hasher that
// returns consumed size). Bytes beyond the scan position are neither
// sized nor validated; callers must bound every read themselves.
func (sc *MixedListViewScanner) Rest() []byte {
	if sc.off > int64(len(sc.d)) {
		return nil
	}
	return sc.d[sc.off:]
}

// Err returns the sticky error that stopped Next, if any.
func (sc *MixedListViewScanner) Err() error { return sc.err }

// MixedListViewMustScanner is Scan()'s traversal with the Must error
// discipline: Next panics with the *ViewError sentinel on malformed
// input (recover via Try*, in the same goroutine — a panic in another
// goroutine cannot be recovered and will crash the process). It has no
// Err method: failure is always a panic, never a quiet stop. Prefer
// Scan where a panic boundary is unacceptable.
type MixedListViewMustScanner struct {
	sc MixedListViewScanner
}

// MustScan returns the panicking twin of Scan() over this array.
func (v MixedListView) MustScan() MixedListViewMustScanner {
	return MixedListViewMustScanner{sc: v.Scan()}
}

// Next advances to the next element; false at the end. Panics with the
// *ViewError sentinel on malformed input.
func (m *MixedListViewMustScanner) Next() bool {
	ok := m.sc.Next()
	if !ok && m.sc.err != nil {
		mustView(m.sc.err)
	}
	return ok
}

// Cur returns the element Next positioned on (exact extent).
func (m *MixedListViewMustScanner) Cur() MixedView { return m.sc.Cur() }

// Rest returns the unvalidated remainder from the current position; see
// the Scan form's Rest.
func (m *MixedListViewMustScanner) Rest() []byte { return m.sc.Rest() }

// Raw returns the exact wire bytes for this view. Views delivered by
// iterators and the Walk are already trimmed to their exact extent, so Raw
// is a slice operation (the exact check precedes any sizing — arguments
// are not evaluated for it); open-ended views (accessor/arm results) are
// sized first.
func (v MixedListView) Raw() ([]byte, error) {
	if v.exact {
		return v.d, nil
	}
	return v.trimmed(v.size(0))
}

// MustRaw is Raw panicking with the *ViewError sentinel (recover via Try*).
func (v MixedListView) MustRaw() []byte {
	raw, err := v.Raw()
	if err != nil {
		mustView(err)
	}
	return raw
}

// Copy returns an independent, detached copy of this view that does not alias the original bytes.
func (v MixedListView) Copy() (MixedListView, error) {
	nv, err := v.copied(v.size(0))
	return MixedListView{nv}, err
}

// ValidateFull checks that this view is well-formed: bounds, schema constraints, and depth limits.
func (v MixedListView) ValidateFull() error { _, err := v.valid(0); return err }
func walkOptionalEntry_OptionalEntry(d []byte, w *OptionalEntryWalk, m uint64, depth int) (int64, error) {
	if depth > maxDepth {
		return 0, viewErrMaxDepth(0)
	}
	if len(d) < 4 {
		return 0, viewErrShortBuffer(0, "need 4 bytes for discriminant")
	}
	disc := int32(binary.BigEndian.Uint32(d[:4]))
	if w.EntryVersion != nil {
		if err := w.EntryVersion(disc); err != nil {
			return 0, err
		}
	}
	off := int64(4)
	switch disc {
	case int32(0):
	case int32(1):
		var sz int64
		var err error
		if m&0x2 != 0 {
			sz, err = walkOptionalEntry_Mixed(d[off:], w, m, depth+1)
		} else {
			var szi int
			szi, err = sizeMixedView(d[off:], depth+1)
			sz = int64(szi)
		}
		if err != nil {
			return 0, err
		}
		off += sz
	default:
		return 0, viewErrUnknownDiscriminant(0, disc)
	}
	if off > int64(len(d)) {
		return 0, viewErrShortBuffer(uint32(off), "arm exceeds data")
	}
	return off, nil
}
func walkOptionalEntry_Mixed(d []byte, w *OptionalEntryWalk, m uint64, depth int) (int64, error) {
	if depth > maxDepth {
		return 0, viewErrMaxDepth(0)
	}
	off := int64(0)
	off += 32
	if off > int64(len(d)) {
		return 0, viewErrShortBuffer(uint32(off), "field offset exceeds data")
	}
	if off > int64(len(d)) {
		return 0, viewErrShortBuffer(uint32(off), "field offset exceeds data")
	}
	{
		sz, err := sizeVarOpaqueView(d[off:], depth+1)
		if err != nil {
			return 0, err
		}
		if w.EntryPayload != nil {
			if err := w.EntryPayload(VarOpaqueView{view{d: d[off : off+int64(sz)], exact: true}}); err != nil {
				return 0, err
			}
		}
		off += int64(sz)
	}
	if off > int64(len(d)) {
		return 0, viewErrShortBuffer(uint32(off), "field offset exceeds data")
	}
	return off, nil
}

// OptionalEntry walk positions (generated manifest, fire order).
const (
	OptionalEntryPosEntryVersion uint8 = iota
	OptionalEntryPosEntryPayload
)

// OptionalEntryWalkPositions is the generated position manifest for WalkOptionalEntry.
var OptionalEntryWalkPositions = []string{
	"EntryVersion",
	"EntryPayload",
}

// OptionalEntryWalk is the position-keyed subscription set for WalkOptionalEntry: nil fields are
// unsubscribed, and subtrees containing no subscribed positions are skipped
// via the thin sizing engine. Any callback may return ErrStopWalk to stop
// the walk cleanly. Derived from the schema plan and the walk spec.
type OptionalEntryWalk struct {
	EntryVersion func(v int32) error
	EntryPayload func(v VarOpaqueView) error
}

// mask returns the subscription's position-reachability mask.
func (w *OptionalEntryWalk) mask() uint64 {
	var m uint64
	if w.EntryVersion != nil {
		m |= 1 << OptionalEntryPosEntryVersion
	}
	if w.EntryPayload != nil {
		m |= 1 << OptionalEntryPosEntryPayload
	}
	return m
}

// WalkOptionalEntry drives w over one OptionalEntry in wire order. A zero subscription returns
// immediately, validating nothing. Truncation stops round up to element/
// array advance boundaries, and the walk validates nothing past the last
// field it owes a subscriber. ErrStopWalk from any callback stops the
// walk cleanly (returns nil); any other error aborts verbatim.
func WalkOptionalEntry(v OptionalEntryView, w *OptionalEntryWalk) error {
	m := w.mask()
	if m == 0 {
		return nil
	}
	_, err := walkOptionalEntry_OptionalEntry(v.d, w, m, 0)
	if err == ErrStopWalk {
		return nil
	}
	return err
}
