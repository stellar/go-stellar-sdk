// error; on the first malformed element it yields (zero view, error) once and
// stops, so errors are in-band and cannot be skipped.
func (v PairsView) All() iter.Seq2[PairView, error] {
	return func(yield func(PairView, error) bool) {
		count, err := arrayViewCountChecked(v.d, 10, 12)
		if err != nil {
