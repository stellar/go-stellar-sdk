type PairView struct{ view }

// NewPairView wraps b (untrusted XDR bytes) in a PairView — a free
// wrapper, not a parse: nothing is validated up front, no error is possible,
// and every subsequent access bounds-checks and validates what it reads.
// Allocation-free.
func NewPairView(b []byte) PairView {
	return PairView{view{d: b}}
}
func sizePairView(_ []byte, _ int) (int, error) { return 12, nil }
func (v PairView) size(depth int) (int, error)  { return sizePairView(v.d, depth) }
func validPairView(d []byte, depth int) (int, error) {
	if len(d) < 12 {
		return 0, viewErrShortBuffer(0, "need 12 bytes")
	}
	off := int64(0)
	{
		sz, err := validInt32View(d[off:], depth+1)
		if err != nil {
			return 0, err
		}
		off += int64(sz)
		if off > int64(len(d)) {
			return 0, viewErrShortBuffer(uint32(off), "field offset exceeds data")
		}
	}
	{
		sz, err := validUint64View(d[off:], depth+1)
		if err != nil {
			return 0, err
		}
		off += int64(sz)
		if off > int64(len(d)) {
			return 0, viewErrShortBuffer(uint32(off), "field offset exceeds data")
		}
	}
	return int(off), nil
}
func (v PairView) valid(depth int) (int, error) { return validPairView(v.d, depth) }

