// Unwrap reads the presence flag: (zero, false, nil) when absent, the inner
// view and true when present, an error when the flag is malformed.
func (v OptionalMixedView) Unwrap() (MixedView, bool, error) {
	if len(v.d) < 4 {
		return MixedView{}, false, viewErrShortBuffer(0, "need 4 bytes for optional flag")
	}
	flag := binary.BigEndian.Uint32(v.d[:4])
	switch flag {
	case 0:
		return MixedView{}, false, nil
	case 1:
		return MixedView{view{d: v.d[4:]}}, true, nil
	default:
		return MixedView{}, false, viewErrBadBoolValue(0, flag)
	}
}

