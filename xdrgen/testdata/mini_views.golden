	d   []byte
	off int64
	n   int
	i   int
	err error
	cur PairView
}

// Scan returns a scanner over this array's elements.
func (v PairsView) Scan() PairsViewScanner {
	sc := PairsViewScanner{d: v.d}
	n, err := arrayViewCountChecked(v.d, 10, 12)
	if err != nil {
		sc.err = err
		return sc
	}
	sc.n = n
	sc.off = 4
	return sc
}

// Next advances to the next element; false at the end or on error (check Err).
func (sc *PairsViewScanner) Next() bool {
	if sc.err != nil || sc.i >= sc.n {
		return false
	}
	if sc.off+12 > int64(len(sc.d)) {
		sc.err = viewErrShortBuffer(uint32(sc.off), "need 12 bytes")
		return false
	}
	sc.cur = PairView{view{d: sc.d[sc.off : sc.off+12], exact: true}}
	sc.off += 12
	sc.i++
	return true
}

