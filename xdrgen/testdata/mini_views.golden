	return v.d[:sz], nil
}

// copied returns a detached view over an independent copy of this view's
// exact wire bytes. It is the shared tail of every generated Copy().
func (v view) copied(sz int, err error) (view, error) {
	raw, err := v.trimmed(sz, err)
	if err != nil {
		return view{}, err
	}
	c := make([]byte, len(raw))
	copy(c, raw)
	return view{d: c}, nil
}

